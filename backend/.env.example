[TEMPLATE]
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=30000
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=30000
GROQ_MAX_COMPLETION_TOKENS=4096

# Local development database. SQLite files do not survive on Vercel.
DATABASE_PATH=meetmind.db

# Persistent hosted database (required on Vercel). Create a Turso database and
# put its URL and token here. When set, DATABASE_PATH is ignored.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

MEETMIND_ENV=development
DEMO_ADMIN_EMAIL=admin@meetmind.demo
DEMO_ADMIN_PASSWORD=MeetMind@123

# Optional one-time production account. Existing users are never overwritten.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=MeetMind Admin

# Comma-separated browser origins allowed to send credentialed requests.
# Production example: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Production defaults: COOKIE_SAMESITE=none and COOKIE_SECURE=true. This is
# required when the frontend and backend are on different Vercel domains.
COOKIE_SAMESITE=
COOKIE_SECURE=

# Google Sign-In. Create a Web application OAuth client in Google Cloud and set
# the same client ID in both the frontend (VITE_GOOGLE_CLIENT_ID) and backend.
GOOGLE_CLIENT_ID=
